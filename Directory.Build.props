<Project>
  <PropertyGroup>
    <!--
      Local machine SDK baseline is .NET 9.0.102 (/home/avi/dotnet/sdk/9.0.102).
      When .NET 10 LTS SDK is installed in CI/dev, update TargetFramework to net10.0
      and align EF Core / AspNetCore packages in Directory.Packages.props to 10.0.*.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>

