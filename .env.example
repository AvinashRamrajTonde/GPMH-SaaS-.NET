# Copy this file to `.env` for local Docker / development usage.
# NEVER commit real passwords, signing keys, or API tokens to Git.

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL (Non-superuser application role `gpmh_app` with NOBYPASSRLS enforced)
POSTGRES_DB=gpmh_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
GPMH_APP_DB_PASSWORD=REPLACE_WITH_LOCAL_APP_DB_PASSWORD
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=gpmh_dev;Username=gpmh_app;Password=REPLACE_WITH_LOCAL_APP_DB_PASSWORD;Include Error Detail=false

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT Signing (minimum 32-byte random cryptographically strong secret in prod/KMS)
JwtSettings__Issuer=https://api.gpmh.in
JwtSettings__Audience=https://app.gpmh.in
JwtSettings__Secret=REPLACE_WITH_RANDOM_MIN_32_CHAR_DEVELOPMENT_SECRET_KEY
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=7

# Field-Level PII / Aadhaar Protection Key (Base64 32-byte key in production KMS)
Security__PiiEncryptionKeyBase64=REPLACE_WITH_BASE64_32_BYTE_KEY

# External Maharashtra LGD Directory API (Trailing slash required for HttpClient base URI resolution)
ExternalServices__LgdApiBaseUrl=https://api.grampanchayatmh.in/api/v1/

